{
  "Logging": {
    "LogLevel": {
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    }
  },
  "MalwareScanner": {
    "Provider": "MetaDefenderCloud",
    "MetaDefenderCloud": {
      "BaseUrl": "https://api.metadefender.com/v4/",
      "PrivateScanning": true,
      "MaximumFileSizeBytes": 1073741824,
      "UploadTimeoutMinutes": 45,
      "PollTimeoutSeconds": 20
    }
  }
}
